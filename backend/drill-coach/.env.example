# Copy to a private .dev.vars file for wrangler dev --local.
# off | mock | live | maintenance (maintenance enables only the command-line admin recovery routes)
COACH_MODE=mock
ALLOWED_ORIGIN=http://localhost:4000
GOOGLE_CLIENT_ID=YOUR_PUBLIC_GOOGLE_CLIENT_ID
OWNER_GOOGLE_SUB=YOUR_VERIFIED_GOOGLE_SUBJECT
DEDUPE_SECRET=YOUR_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Use a Worker secret in production. Leave absent in local/mock mode.
# OPENAI_API_KEY=
# Set only during a recovery, then delete it. See docs/drill-coach-setup.md.
# ADMIN_RECOVERY_SECRET=
